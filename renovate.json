{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Annotated pins in the cluster dirs: Flux postBuild *_VERSION substitutes, OCIRepository ref.tag and Kustomization images[].newTag, and container image: <dep>:<version> lines, each followed by `# datasource=<ds> depName=<dep>` on the same line. Same convention as stuttgart-things/stuttgart-things. Nothing may stand between value and annotation -- an unmatched pin is not an error, it is silence. Helm charts add `registryUrl=<repo>`.",
      "matchStrings": [
        "\\s*(?<binName>[A-Za-z0-9_]+_VERSION|tag|newTag):\\s[\"']?(?<currentValue>v?\\d+\\.\\d+\\.\\d+)[\"']?\\s*#\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?",
        "\\s*image:\\s[^\\s:]+:(?<currentValue>v?\\d+\\.\\d+\\.\\d+)\\s*#\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)"
      ],
      "versioningTemplate": "semver",
      "managerFilePatterns": [
        "/^clusters/.+\\.ya?ml$/"
      ]
    },
    {
      "customType": "regex",
      "description": "Track both edge Flux repo pins without modifying generated YAML just to add annotations. ClusterApps lists url before tag; the generated OCIRepository lists ref.tag before url.",
      "managerFilePatterns": [
        "/^clusters/edge/(?:cluster-apps|apps)\\.yaml$/"
      ],
      "matchStrings": [
        "url:\\s*oci://ghcr\\.io/stuttgart-things/flux/repo\\s+tag:\\s*(?<currentValue>v?\\d+\\.\\d+\\.\\d+)",
        "ref:\\s+tag:\\s*(?<currentValue>v?\\d+\\.\\d+\\.\\d+)\\s+url:\\s*oci://ghcr\\.io/stuttgart-things/flux/repo(?:\\s|$)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/stuttgart-things/flux/repo",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track Edge HOMERUN2_NOTIFICATION_CATCHER_VERSION in its version-only mirror.",
      "managerFilePatterns": [
        "/^clusters/edge/apps/apps-platform\\.yaml$/"
      ],
      "matchStrings": [
        "\\bHOMERUN2_NOTIFICATION_CATCHER_VERSION:\\s*[\"']?(?<currentValue>v?\\d+\\.\\d+\\.\\d+(?:-v\\d+)?)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/stuttgart-things/homerun2-notification-catcher",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track Edge HOMERUN2_NOTIFICATION_CATCHER_KUSTOMIZE_VERSION in its version-only mirror.",
      "managerFilePatterns": [
        "/^clusters/edge/apps/apps-platform\\.yaml$/"
      ],
      "matchStrings": [
        "\\bHOMERUN2_NOTIFICATION_CATCHER_KUSTOMIZE_VERSION:\\s*[\"']?(?<currentValue>v?\\d+\\.\\d+\\.\\d+(?:-v\\d+)?)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/stuttgart-things/homerun2-notification-catcher-kustomize",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track Edge HOMERUN2_REDIS_IMAGE_VERSION in its version-only mirror.",
      "managerFilePatterns": [
        "/^clusters/edge/(?:cluster-apps|apps/apps-platform)\\.yaml$/"
      ],
      "matchStrings": [
        "\\bHOMERUN2_REDIS_IMAGE_VERSION:\\s*[\"']?(?<currentValue>v?\\d+\\.\\d+\\.\\d+(?:-v\\d+)?)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/stuttgart-things/redis-stack-server",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-v(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Track Edge MINIO_VERSION in its version-only mirror.",
      "managerFilePatterns": [
        "/^clusters/edge/(?:cluster-apps|apps/apps-platform)\\.yaml$/"
      ],
      "matchStrings": [
        "\\bMINIO_VERSION:\\s*[\"']?(?<currentValue>v?\\d+\\.\\d+\\.\\d+(?:-v\\d+)?)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/stuttgart-things/charts/minio/minio",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Keep the edge ClusterApps input and generated OCIRepository pin together in one reviewed promotion.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "ghcr.io/stuttgart-things/flux/repo"
      ],
      "matchFileNames": [
        "clusters/edge/cluster-apps.yaml",
        "clusters/edge/apps.yaml"
      ],
      "groupName": "edge Flux bundle",
      "groupSlug": "edge-flux-bundle"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "ghcr.io/stuttgart-things/homerun2-notification-catcher",
        "ghcr.io/stuttgart-things/homerun2-notification-catcher-kustomize"
      ],
      "matchFileNames": [
        "clusters/edge/**"
      ],
      "groupName": "edge notification catcher",
      "groupSlug": "edge-notification-catcher"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "ghcr.io/stuttgart-things/redis-stack-server"
      ],
      "matchFileNames": [
        "clusters/edge/**"
      ],
      "groupName": "edge Redis Stack",
      "groupSlug": "edge-redis-stack"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "ghcr.io/stuttgart-things/charts/minio/minio"
      ],
      "matchFileNames": [
        "clusters/edge/**"
      ],
      "groupName": "edge MinIO",
      "groupSlug": "edge-minio"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "ghcr.io/stuttgart-things/zaehlwerk-log-sink"
      ],
      "matchFileNames": [
        "clusters/edge/**"
      ],
      "groupName": "edge Zaehlwerk log sink",
      "groupSlug": "edge-zaehlwerk-log-sink"
    },
    {
      "description": "Chart 17 needs a separate console image and licensing review; retain the Flux catalogue hold.",
      "matchPackageNames": [
        "ghcr.io/stuttgart-things/charts/minio/minio"
      ],
      "allowedVersions": "<17.0.0"
    }
  ]
}
