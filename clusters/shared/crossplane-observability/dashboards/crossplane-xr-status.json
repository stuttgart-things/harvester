      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(max by (customresource_kind, namespace, name) (crossplane_mr_status_condition{type=\"Synced\", composite=~\"$composite\"}) == 0) or vector(0)",
