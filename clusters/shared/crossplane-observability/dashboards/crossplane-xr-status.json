    {
      "type": "table",
      "title": "XRs with Ready or Synced not True",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(time() - max by (customresource_kind, namespace, name, composite, type) (crossplane_xr_status_condition_last_transition_time{type=~\"Ready|Synced\", customresource_kind=~\"$kind\", composite=~\"$composite\"}))\n* on (customresource_kind, namespace, name, type) group_left (reason)\n((max by (customresource_kind, namespace, name, type, reason) (crossplane_xr_status_condition{type=~\"Ready|Synced\", customresource_kind=~\"$kind\", composite=~\"$composite\"}) == 0) + 1)",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "customresource_kind": 0,
              "namespace": 1,
              "name": 2,
              "type": 3,
              "reason": 4,
              "Value": 5,
              "composite": 6
            },
            "renameByName": {
              "customresource_kind": "kind",
              "type": "condition",
              "Value": "since",
              "composite": "top-level XR"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "noValue": ""
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "since"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "orange",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1800
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "since",
            "desc": true
          }
        ]
      },
      "description": "One row per XR and condition that is not True. `since` = time since the condition last changed (lastTransitionTime). Empty = all XRs Ready and Synced."
    },
    {
      "type": "table",
      "title": "All XRs",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (customresource_kind, namespace, name, composite) (crossplane_xr_status_condition{type=\"Ready\", customresource_kind=~\"$kind\", composite=~\"$composite\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (customresource_kind, namespace, name, composite) (crossplane_xr_status_condition{type=\"Synced\", customresource_kind=~\"$kind\", composite=~\"$composite\"})",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (customresource_kind, namespace, name, composite) (time() - crossplane_xr_status_condition_last_transition_time{type=\"Ready\", customresource_kind=~\"$kind\", composite=~\"$composite\"})",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (customresource_kind, namespace, name, composite) (crossplane_xr_resource_ref{customresource_kind=~\"$kind\", composite=~\"$composite\"})",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (customresource_kind, namespace, name, composite, composition) (crossplane_xr_info{customresource_kind=~\"$kind\", composite=~\"$composite\"})",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (customresource_kind, namespace, name, composite) (time() - crossplane_xr_created{customresource_kind=~\"$kind\", composite=~\"$composite\"})",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #E": true
            },
            "indexByName": {
              "customresource_kind": 0,
              "namespace": 1,
              "name": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #D": 6,
              "composition": 7,
              "composite": 8,
              "Value #F": 9
            },
            "renameByName": {
              "customresource_kind": "kind",
              "Value #A": "Ready",
              "Value #B": "Synced",
              "Value #C": "Ready changed",
              "Value #D": "composed",
              "composite": "top-level XR",
              "Value #F": "age"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "noValue": ""
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Ready"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "True",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "False",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Synced"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "True",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "False",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ready changed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Ready",
            "desc": false
          }
        ]
      },
      "description": "Every XR: Ready/Synced, time since Ready last changed, number of composed resources (spec.crossplane.resourceRefs), Composition, top-level XR (label crossplane.io/composite)."
    },
