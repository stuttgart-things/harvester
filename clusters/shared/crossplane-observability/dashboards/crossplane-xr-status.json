          "expr": "count(max by (customresource_kind, namespace, name) (crossplane_xr_status_condition{type=\"Synced\", customresource_kind=~\"$kind\", composite=~\"$composite\"}) == 0) or vector(0)",
          "refId": "A",
          "instant": true,
